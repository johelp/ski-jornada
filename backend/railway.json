{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "NIXPACKS", "buildCommand": "npm install && npx prisma generate" },
  "deploy": {
    "startCommand": "npx prisma migrate deploy && node prisma/bootstrap.js && node index.js",
    "healthcheckPath": "/api/server-time",
    "restartPolicyType": "ON_FAILURE"
  }
}
