PORT=3000
# Obligatorio: cadena larga y aleatoria (ej. `openssl rand -hex 32`)
JWT_SECRET=
DATABASE_URL=file:./prisma/dev.db

# Gmail: usar "contraseña de aplicación"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=
EMAIL_FROM=Ski Jornada <tucorreo@gmail.com>

# URL(s) del frontend, separadas por coma (CORS + links de email)
FRONTEND_URL=http://localhost:5173

# Opcional: requiere `npm install @whiskeysockets/baileys`
# WHATSAPP_ENABLED=true

# Solo desarrollo/demo: permite login con contraseña (usuarios del seed, clave ski123)
# PASSWORD_LOGIN=true

# Producción: primer administrador (lo crea prisma/bootstrap.js en cada deploy si no existe)
# ADMIN_EMAIL=admin@tuescuela.com
# ADMIN_NOMBRE=Nombre
# ADMIN_APELLIDOS=Apellidos
# Carpeta de PDFs subidos (apuntar al volumen persistente, ej. /data/uploads)
# UPLOAD_DIR=/data/uploads
