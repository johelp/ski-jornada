generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profesor {
  id               String   @id @default(uuid())
  email            String   @unique
  nombre           String
  apellidos        String
  password         String   @default("")
  tipoJornada      String   @default("COMPLETA")
  horasContrato    Int      @default(35)
  role             String   @default("PROFESOR")
  activo           Boolean  @default(true)
  telefono         String?
  horaRecordatorio String   @default("17:00")
  avisosWhatsapp   Boolean  @default(false)
  tarifaHora       Float?
  adheridoAt       DateTime?
  esPrincipal      Boolean  @default(false)
  createdAt        DateTime @default(now())

  registros                RegistroJornada[]
  solicitudes              SolicitudLibre[]
  firmasRegistro           FirmaRegistro[]
  documentos               DocumentoLegajo[]
  clasesDadas              ClaseDada[]
  confirmacionesClases     ConfirmacionClases[]
  magicLinks               MagicLink[]
  revisionesClases         RevisionMes[]
  planning                 PlanningClase[]
  aceptaciones             AceptacionLegal[]
  notificacionesRecibidas  Notificacion[] @relation("NotifRecibidas")
  notificacionesEnviadas   Notificacion[] @relation("NotifEnviadas")
}

model ZonaFichaje {
  id             String   @id @default(uuid())
  nombre         String
  descripcion    String   @default("")
  secret         String   @default("")
  lat            Float?
  lng            Float?
  radio          Int      @default(100)
  validationMode String   @default("TOTP_GPS")
  activa         Boolean  @default(true)
  createdAt      DateTime @default(now())

  registros RegistroJornada[]
}

model RegistroJornada {
  id           String      @id @default(uuid())
  profesorId   String
  profesor     Profesor    @relation(fields: [profesorId], references: [id])
  zonaId       String
  zonaNombre   String
  zona         ZonaFichaje @relation(fields: [zonaId], references: [id])
  tipo         String
  timestamp    DateTime    @default(now())
  lat          Float?
  lng          Float?
  distancia    Int?
  esIncidencia Boolean     @default(false)
  origen       String      @default("APP")   // APP · ADMIN (alta manual de administración)
  anulado      Boolean     @default(false)   // nunca se borra: se anula y queda la huella
  correcciones CorreccionFichaje[]
}

// Cada cambio de administración sobre un fichaje (alta manual, modificación, anulación) conserva el valor original,
// quién lo hizo, cuándo y por qué. Se conserva con el registro (4 años).
model CorreccionFichaje {
  id            String          @id @default(uuid())
  registroId    String
  registro      RegistroJornada @relation(fields: [registroId], references: [id])
  profesorId    String
  accion        String          // CREAR · MODIFICAR · ANULAR
  anterior      String?         // JSON {tipo, timestamp} antes del cambio
  nuevo         String?         // JSON {tipo, timestamp} después del cambio
  motivo        String
  actorId       String?
  actorEmail    String?
  createdAt     DateTime        @default(now())

  @@index([profesorId, createdAt])
}

model SolicitudLibre {
  id             String    @id @default(uuid())
  profesorId     String
  profesor       Profesor  @relation(fields: [profesorId], references: [id])
  fechaInicio    DateTime
  fechaFin       DateTime
  motivo         String
  comentario     String?
  estado         String    @default("PENDIENTE")
  observacion    String?
  aprobadoPor    String?
  fechaRespuesta DateTime?
  createdAt      DateTime  @default(now())
}

model FirmaRegistro {
  id             String    @id @default(uuid())
  profesorId     String
  profesor       Profesor  @relation(fields: [profesorId], references: [id])
  mes            String
  estado         String    @default("PENDIENTE")
  emailEnviadoAt DateTime?
  pdfFirmadoPath String?
  firmadoAt      DateTime?
  createdAt      DateTime  @default(now())

  @@unique([profesorId, mes])
}

model DocumentoLegajo {
  id          String    @id @default(uuid())
  profesorId  String
  profesor    Profesor  @relation(fields: [profesorId], references: [id])
  tipo        String
  nombre      String
  mes         String?
  archivoPath String
  subidoPor   String
  estado      String    @default("PENDIENTE")
  firmaPath   String?
  firmadoAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Notificacion {
  id           String   @id @default(uuid())
  titulo       String
  mensaje      String
  tipo         String   @default("INFO")
  profesorId   String
  enviadaPorId String
  leida        Boolean  @default(false)
  createdAt    DateTime @default(now())
  profesor     Profesor @relation("NotifRecibidas", fields: [profesorId],   references: [id])
  enviadaPor   Profesor @relation("NotifEnviadas",  fields: [enviadaPorId], references: [id])
}

model ConfigEscuela {
  id            String   @id @default("default")
  nombre        String   @default("Escuela de Esquí Sierra Nevada")
  cif           String   @default("B12345678")
  direccion     String   @default("Sierra Nevada, Granada")
  telefono      String   @default("958 000 000")
  email         String   @default("")
  colorPrimario String   @default("#0f4c81")
  updatedAt     DateTime @updatedAt
}

model TipoClase {
  id      String      @id @default(uuid())
  nombre  String      @unique
  activo  Boolean     @default(true)
  orden   Int         @default(0)
  clases  ClaseDada[]
}

model PrimaClase {
  id      String      @id @default(uuid())
  nombre  String      @unique
  activa  Boolean     @default(true)
  orden   Int         @default(0)
  importe Float?
  modo    String      @default("POR_HORA")
  clases  ClaseDada[]
}

model ClaseDada {
  id         String       @id @default(uuid())
  profesorId String
  profesor   Profesor     @relation(fields: [profesorId], references: [id])
  fecha      String
  horas      Float
  tipoId     String
  tipo       TipoClase    @relation(fields: [tipoId], references: [id])
  primas     PrimaClase[]
  notas      String?
  marca      String?
  notaAdmin  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([profesorId, fecha])
}

model ConfirmacionClases {
  id           String    @id @default(uuid())
  profesorId   String
  profesor     Profesor  @relation(fields: [profesorId], references: [id])
  mes          String
  confirmadoAt DateTime  @default(now())
  tarifaHora   Float?
  primasJson   String?

  @@unique([profesorId, mes])
}

model MagicLink {
  id         String   @id @default(uuid())
  profesorId String
  profesor   Profesor @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  codigoHash String?
  intentos   Int      @default(0)
  expiraAt   DateTime
  createdAt  DateTime @default(now())
}

model RevisionMes {
  id            String   @id @default(uuid())
  profesorId    String
  profesor      Profesor @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  mes           String
  estado        String
  nota          String?
  revisadoPorId String?
  revisadoAt    DateTime @default(now())

  @@unique([profesorId, mes])
}

model ApiKey {
  id          String    @id @default(uuid())
  nombre      String
  prefijo     String
  keyHash     String    @unique
  scopes      String    @default("lectura")
  activa      Boolean   @default(true)
  ultimoUso   DateTime?
  creadaPorId String?
  createdAt   DateTime  @default(now())
}

model Webhook {
  id           String    @id @default(uuid())
  url          String
  secret       String
  eventos      String    @default("*")
  activo       Boolean   @default(true)
  ultimoEstado Int?
  ultimoEnvio  DateTime?
  createdAt    DateTime  @default(now())
}

model PlanningClase {
  id         String   @id @default(uuid())
  profesorId String
  profesor   Profesor @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  fecha      String
  horas      Float
  disciplina String?
  referencia String   @default("")
  fuente     String   @default("API")
  createdAt  DateTime @default(now())

  @@unique([profesorId, fecha, referencia])
  @@index([profesorId, fecha])
}

// Nombre con el que aparece un profesor en un sistema externo (p. ej. el de reservas) → profesor de la plataforma
model AliasProfesor {
  id            String   @id @default(uuid())
  nombreExterno String   @unique
  profesorId    String
  createdAt     DateTime @default(now())
}

// Registro de acciones sensibles de administración (altas, bajas, roles, invitaciones, integraciones)
model AuditoriaLog {
  id            String   @id @default(uuid())
  actorId       String?
  actorEmail    String?
  accion        String
  objetivoId    String?
  objetivoEmail String?
  detalle       String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}

// Constancia de que una persona recibió la información de privacidad (art. 13 RGPD) o, en la cuenta principal,
// aceptó el contrato de encargo de tratamiento en nombre de la escuela. Se versiona: al cambiar el texto se vuelve a pedir.
model AceptacionLegal {
  id         String   @id @default(uuid())
  profesorId String
  profesor   Profesor @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  documento  String
  version    String
  aceptadoAt DateTime @default(now())

  @@unique([profesorId, documento, version])
}
