# ───────────────────────────────────────────────────────────────
# Variables de BUILD del FRONTEND (Cloudflare Pages) para un cliente nuevo.
# Se incrustan al compilar: si cambian, hay que re-desplegar.
# ───────────────────────────────────────────────────────────────
NODE_VERSION=20
VITE_API_URL=https://api.<cliente>.<tu-dominio>
# Marca de la landing (opcionales)
VITE_APP_NAME=<Nombre de la escuela o producto>
VITE_ESCUELA_LUGAR=<Ciudad, Provincia>
VITE_COLOR_PRIMARIO=#0f4c81
# Email de contacto para «Solicitar el alta de mi escuela» en la landing (si se omite, no se muestra)
# VITE_CONTACTO_EMAIL=<contacto@tudominio.com>
