# ───────────────────────────────────────────────────────────────
# Plantilla de variables del BACKEND (Railway) para un cliente nuevo.
# Copiar a un archivo privado (NO versionar) y completar los <...>.
# Guía completa: docs/MULTI-DESPLIEGUE.md
# ───────────────────────────────────────────────────────────────
NODE_ENV=production
# Cadena aleatoria única por cliente:  openssl rand -hex 32
JWT_SECRET=<generar>
# Base y archivos en el volumen de Railway montado en /data
DATABASE_URL=file:/data/prod.db
UPLOAD_DIR=/data/uploads
# URL pública del frontend de ESTE cliente (varias, separadas por coma)
FRONTEND_URL=https://<cliente>.<tu-dominio>
# Primer administrador (se crea solo en el primer arranque)
ADMIN_EMAIL=<email-admin>
# Cuenta principal de administración: puede ser de empresa (ej. administracion@escuela.com, nombre «Administración», sin apellidos)
ADMIN_NOMBRE=<Nombre o «Administración»>
ADMIN_APELLIDOS=<Apellidos, o vacío si es cuenta de empresa>
# Correo (Resend): dominio verificado y remitente de ESTE cliente
RESEND_API_KEY=<re_...>
EMAIL_FROM=<Nombre escuela> <no-reply@<cliente>.<tu-dominio>>
# Tus datos como encargado del tratamiento y dónde están los datos (salen en los textos legales)
PROVEEDOR_NOMBRE=<tu nombre o razón social>
PROVEEDOR_CIF=<tu CIF/NIF>
PROVEEDOR_EMAIL=<tu correo de contacto>
DATOS_REGION=la Unión Europea (<país de la región de Railway>)
# Notificaciones push: generar UNA vez con `cd backend && npm run vapid` y no cambiarlas
VAPID_PUBLIC_KEY=<generar>
VAPID_PRIVATE_KEY=<generar>
VAPID_SUBJECT=mailto:<correo-admin>
# Opcionales por cliente:
# DOCUMENTOS_HABILITADOS=false        → las nóminas se firman fuera de la plataforma
# FIRMA_PANTALLA_HABILITADA=false     → oculta la firma dibujada en pantalla
# No definir en producción: PASSWORD_LOGIN, SEED_DEMO, SEED_EMAILS, PUSH_SIMULADO, FLOTA_ON (la flota es solo del proveedor)
# WHATSAPP_ENABLED=false  → solo si el cliente NO debe tener el módulo de WhatsApp (por defecto está disponible y apagado)
