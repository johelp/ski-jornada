# ───────────────────────────────────────────────────────────────
# Plantilla de variables del BACKEND (Railway) para un cliente nuevo.
# Copiar a un archivo privado (NO versionar) y completar los <...>.
# Guía completa: docs/MULTI-DESPLIEGUE.md
# ───────────────────────────────────────────────────────────────
NODE_ENV=production
# Cadena aleatoria única por cliente:  openssl rand -hex 32
JWT_SECRET=<generar>
# Base y archivos en el volumen de Railway montado en /data
DATABASE_URL=file:/data/prod.db
UPLOAD_DIR=/data/uploads
# URL pública del frontend de ESTE cliente (varias, separadas por coma)
FRONTEND_URL=https://<cliente>.<tu-dominio>
# Primer administrador (se crea solo en el primer arranque)
ADMIN_EMAIL=<email-admin>
ADMIN_NOMBRE=<Nombre>
ADMIN_APELLIDOS=<Apellidos>
# Correo (Resend): dominio verificado y remitente de ESTE cliente
RESEND_API_KEY=<re_...>
EMAIL_FROM=<Nombre escuela> <no-reply@<cliente>.<tu-dominio>>
# No definir en producción: PASSWORD_LOGIN, WHATSAPP_ENABLED (solo si se contrata)
